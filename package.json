{
  "name": "homebridge-homematicip",
  "version": "2.7.0",
  "description": "Homematic IP plugin for homebridge",
  "license": "Apache-2.0",
  "author": "Marc Sowen <marc@sowen.net>",
  "keywords": [
    "homebridge-plugin",
    "homekit",
    "homematic",
    "homematicip",
    "hmip"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marcsowen/homebridge-homematicip.git"
  },
  "bugs": {
    "url": "https://github.com/marcsowen/homebridge-homematicip/issues"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "homebridge-homematicip-dump": "dist/cli/dumpDevices.js"
  },
  "files": [
    "dist",
    "config.schema.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "lint": "biome check src",
    "test": "pnpm run build && node --test test/*.test.js",
    "watch": "pnpm run build && pnpm link && nodemon",
    "build": "rimraf ./dist && tsc",
    "prepublishOnly": "pnpm run lint && pnpm run test"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0",
    "homebridge": "^2.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@types/node": "^24.10.1",
    "homebridge": "^2.2.1",
    "nodemon": "^3.1.14",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "fakegato-history": "^0.6.7",
    "homematicip-cloud-client-ts": "^0.2.1"
  }
}
